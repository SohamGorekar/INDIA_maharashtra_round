# Copy this file to .env and fill in your own values.
# .env is gitignored -- never commit real keys.

# --- Language model -------------------------------------------------------
# Which provider the agent uses: mistral | gemini
LLM_PROVIDER=mistral

# Mistral: https://console.mistral.ai/api-keys
# Free tier allows roughly 1 request/second.
MISTRAL_API_KEY=your-key-here
# MISTRAL_MODEL=ministral-14b-latest

# Gemini: https://aistudio.google.com/apikey
# Free tier allows only 5 requests/minute per model.
GOOGLE_API_KEY=your-key-here
# GEMINI_MODEL=gemini-3.8-flash

# Check which models your keys can actually use:
#   python -m support.agent.models

# --- Database -------------------------------------------------------------
# Supabase: Project Settings -> Database -> Connection string -> URI.
# Use the POOLED url (port 6543), with your database password substituted in.
DATABASE_URL=

# Set to 1 to ignore DATABASE_URL and use a local SQLite file instead.
# Leaving DATABASE_URL blank has the same effect. Tests always use SQLite.
LOCAL_SQLITE=0
